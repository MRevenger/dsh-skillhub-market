{
  "name": "@local/dsh-skillhub-market",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Skillhub marketplace and installed-skill manager for DeepSeek Harness",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    },
    "engines": {
      "dsh": ">=0.2.2-rc.1"
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test --test-isolation=none --experimental-strip-types test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "esbuild": "^0.25.0",
    "esbuild-wasm": "^0.25.12",
    "typescript": "^5.7.0"
  }
}
